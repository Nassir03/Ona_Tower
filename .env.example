# Frontend (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8400/api

# Backend (FastAPI)
APP_NAME=ONA Towers API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8400
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
LOG_LEVEL=INFO

# Local development defaults to SQLite for zero-setup startup.
# For PostgreSQL, replace with for example:
# DATABASE_URL=postgresql+psycopg://ona_user:ona_password@localhost:5432/ona_towers
DATABASE_URL=sqlite+pysqlite:///./ona_towers.db
AUTO_INIT_DB=true

# Backend-side anti-spam/rate limiting
ENQUIRY_RATE_LIMIT_COUNT=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
DUPLICATE_ENQUIRY_WINDOW_SECONDS=120
MAX_MESSAGE_LENGTH=2000

# Optional SMTP notification settings
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ONA Towers
SMTP_USE_TLS=true
SALES_NOTIFICATION_EMAIL=
