APP_NAME=ONA Towers API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
LOG_LEVEL=INFO
DATABASE_URL=sqlite+pysqlite:///./ona_towers.db
AUTO_INIT_DB=true
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010,http://localhost:3000,http://127.0.0.1:3000
ENQUIRY_RATE_LIMIT_COUNT=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=3600
DUPLICATE_ENQUIRY_WINDOW_SECONDS=120
MAX_MESSAGE_LENGTH=2000
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ONA Towers
SMTP_USE_TLS=true
SALES_NOTIFICATION_EMAIL=
# Vite proxies /api to FastAPI at http://127.0.0.1:8400 during local development.
VITE_API_BASE_URL=/api
VITE_ADMIN_EMAIL=oniriaassist@gmail.com
GEMINI_API_KEY=

# Local bootstrap administrator. Change these before production.
ADMIN_EMAIL=oniriaassist@gmail.com
ADMIN_PASSWORD=Oniria@1234.
ADMIN_NAME=Oniria Assistant
ADMIN_ROLE=Admin
ADMIN_DEPARTMENT=Admin
ADMIN_SESSION_SECRET=ona-local-development-secret
ADMIN_SESSION_HOURS=12
