APP_ENV=production
APP_DEBUG=false
API_PREFIX=/api
AUTO_INIT_DB=false

# Supabase Transaction pooler (port 6543) for Vercel runtime.
DATABASE_URL=

# Optional here; normally only used from a trusted local/CI migration job.
MIGRATION_DATABASE_URL=

# Frontend and backend share one Vercel origin, so no production CORS entry is required.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=ONA Administrator
ADMIN_ROLE=Administrator
ADMIN_DEPARTMENT=Administration
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
