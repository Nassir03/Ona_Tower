{
  "name": "ona-towers-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vercel dev -L",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 8400",
    "build": "npm --prefix frontend run build",
    "check:frontend": "npm --prefix frontend run check",
    "test:backend": "python -m pytest -c backend/pyproject.toml backend/tests -q",
    "db:upgrade": "python -m alembic -c database/alembic.ini upgrade head",
    "db:current": "python -m alembic -c database/alembic.ini current",
    "db:seed": "python scripts/db_seed.py",
    "db:check": "python scripts/db_check.py"
  }
}
